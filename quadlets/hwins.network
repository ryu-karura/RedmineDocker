# quadlets/hwins.network
#
# Podman Quadlet network definition for the hwins Redmine stack.
# Place at /etc/containers/systemd/hwins.network (system) or
# ~/.config/containers/systemd/hwins.network (rootless), then run:
#   systemctl [--user] daemon-reload
#
# Creates a dedicated bridge network with DNS so the containers reach each
# other by name (hwins-db, hwins-redmine, hwins-static). No database or Puma
# port is exposed to the host.

[Network]
NetworkName=hwins-net
Driver=bridge

[Install]
WantedBy=multi-user.target
