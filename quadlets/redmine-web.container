# quadlets/redmine-web.container
#
# redmine-web 用の Podman Quadlet ユニットです: Redmine 6.1.3 + plugin stack。
# /etc/containers/systemd/redmine-web.container に配置し、次を実行します:
#   systemctl daemon-reload && systemctl start redmine-web
#
# DB パスワードと secret_key_base は Podman シークレットです（docs/Setup.md 参照）。
# Apache フロントエンドが :80 で公開されます。その先のアプリサーバーは
# REDMINE_WEB_SERVER で切り替えます:
#   puma      (既定) Apache -> ProxyPass -> コンテナ内部の Puma :3000
#   passenger        Apache + mod_passenger が Redmine を直接起動（:3000 なし）
# 切り替えは下の Environment= を書き換えて再起動するだけです（イメージ再ビルド不要）。
# SMTP 設定（あれば）には下の EnvironmentFile を使います。

[Unit]
Description=redmine Redmine アプリケーション 6.1.3
Documentation=file:///opt/redmine/containers/docs/Design.md
After=network-online.target redmine-db.service
Wants=network-online.target
Requires=redmine-db.service

[Container]
Image=localhost/redmine-web:6.1.3
ContainerName=redmine-web
Network=redmine-net
PublishPort=127.0.0.1:80:80

Environment=RAILS_ENV=production
Environment=RAILS_RELATIVE_URL_ROOT=/redmine
Environment=RUBY_YJIT_ENABLE=1
# アプリサーバー: puma（既定）または passenger。
Environment=REDMINE_WEB_SERVER=puma
Environment=REDMINE_PUMA_PORT=3000
Environment=REDMINE_DB_HOST=redmine-db
Environment=REDMINE_DB_NAME=redmine
Environment=REDMINE_DB_USER=redmine
Environment=REDMINE_DB_PASSWORD_FILE=/run/secrets/db_password
Environment=REDMINE_SECRET_KEY_BASE_FILE=/run/secrets/secret_key_base
Environment=REDMINE_PLUGINS_MIGRATE=1
# 公式イメージ同様、値を設定するとコアの db:migrate をスキップします
# （既定は未設定 = 起動時にマイグレーションを実行）。
# Environment=REDMINE_NO_DB_MIGRATE=1
# 初回起動時（roles テーブルが空）のみ、日本語の既定データを投入します。
Environment=REDMINE_LOAD_DEFAULT_DATA=1
Environment=REDMINE_DEFAULT_DATA_LANG=ja
# オプションの非シークレット設定（SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD）。
# 先頭の '-' はファイルが存在しなくても無視するための指定です。
EnvironmentFile=-/opt/redmine/containers/.env

Secret=db_password,type=mount,target=db_password
Secret=secret_key_base,type=mount,target=secret_key_base

# アップロードした添付ファイルとログを redmine データルート配下に永続化します。
Volume=/opt/redmine/data/redmine/files:/usr/src/redmine/files:Z
Volume=/opt/redmine/data/redmine/log:/usr/src/redmine/log:Z

Timezone=Asia/Tokyo

# 判定ロジックはイメージ内のスクリプトに置いています。HealthCmd= は Quadlet 側で
# 変数展開されないため、サブ URI や REDMINE_WEB_SERVER はスクリプトが
# コンテナの環境変数から解決します（compose.dev.yaml と同じコマンド）。
HealthCmd=/usr/local/bin/redmine-healthcheck.sh
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=180s

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
