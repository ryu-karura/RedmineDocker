# quadlets/redmine-next.container
#
# Podman Quadlet container unit for Docker3: Version Upgrade Testing Environment
# Place in /etc/containers/systemd/redmine-next.container
# Run: systemctl daemon-reload
#
# Generated systemd service: redmine-next.service
# Start: systemctl start redmine-next
# Enable: systemctl enable redmine-next
#
# Access: https://hostname/redmine-next
# Internal: http://127.0.0.1:10082/redmine-next
#
# This environment tracks Redmine's main branch (7.0-dev).
# Rebuild the image regularly: podman build --no-cache -t localhost/redmine-next:dev containers/docker3/

[Unit]
Description=Redmine Version Upgrade Test Environment (main/7.0-dev)
Documentation=file:///opt/redmine/containers/docs/Design.md
After=network-online.target redmine-db.service
Wants=network-online.target
Requires=redmine-db.service

[Container]
Image=localhost/redmine-next:dev
ContainerName=redmine-next

Network=redmine_net
IP=10.89.1.13

PublishPort=127.0.0.1:10082:80

EnvironmentFile=/opt/redmine/containers/.env
Environment=RAILS_ENV=production
Environment=RAILS_RELATIVE_URL_ROOT=/redmine-next
Environment=REDMINE_DB_HOST=redmine-db
Environment=REDMINE_DB_NAME=redmine_next
Environment=REDMINE_DB_USER=redmine_adm

Volume=/opt/redmine/data/redmine3/files:/opt/redmine/app/files:Z
Volume=/opt/redmine/data/redmine3/log:/opt/redmine/app/log:Z
Volume=/opt/redmine/data/redmine3/public/assets:/opt/redmine/app/public/assets:Z
Volume=/opt/redmine/data/redmine3/public/plugin_assets:/opt/redmine/app/public/plugin_assets:Z
Volume=/opt/redmine/data/redmine3/tmp:/opt/redmine/app/tmp:Z

Timezone=UTC

HealthCmd=curl -f -s http://localhost/redmine-next/login > /dev/null
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=180s

[Service]
Restart=on-failure
RestartSec=10s
StartLimitBurst=5
StartLimitIntervalSec=120s
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
