# quadlets/hwins-static.container
#
# hwins-static 用の Podman Quadlet ユニットです: Apache httpd 2.4 reverse proxy。
# /etc/containers/systemd/hwins-static.container に配置し、次を実行します:
#   systemctl daemon-reload && systemctl start hwins-static
#
# これは唯一のホスト公開コンテナです。ループバックにバインドされ、18080 で公開されます。
# ホスト Apache が 443 で TLS を終端し、/redmine をこのコンテナに転送します。

[Unit]
Description=hwins Redmine 静的/プロキシ層 (Apache httpd 2.4)
Documentation=file:///opt/hwins/containers/docs/Design.md
After=network-online.target hwins-redmine.service
Wants=network-online.target
Requires=hwins-redmine.service

[Container]
Image=localhost/hwins-static:2.4
ContainerName=hwins-static
Network=hwins-net

# ループバックのみ公開します。外部アクセスは 443 のホスト Apache 経由です。
PublishPort=127.0.0.1:18080:80

Timezone=Asia/Tokyo

HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/80'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
