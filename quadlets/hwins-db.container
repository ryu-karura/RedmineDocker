# quadlets/hwins-db.container
#
# hwins-db 用の Podman Quadlet ユニットです: PostgreSQL 18 + PostGIS 3.6。
# /etc/containers/systemd/hwins-db.container に配置し、次を実行します:
#   systemctl daemon-reload && systemctl start hwins-db
#
# データベースパスワードは Podman シークレットとして提供されます
# （一度だけ: podman secret create db_password /opt/hwins/containers/secrets/db_password.txt）。
# ポート 5432 は意図的に公開しません。

[Unit]
Description=hwins Redmine データベース (PostgreSQL 18 + PostGIS 3.6)
Documentation=file:///opt/hwins/containers/docs/Design.md
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/hwins-db:18-3.6
ContainerName=hwins-db
Network=hwins-net

# Redmine のロール / データベースはこれらの変数からイメージ側で作成されます。
Environment=POSTGRES_DB=redmine
Environment=POSTGRES_USER=redmine
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db_password
Secret=db_password,type=mount,target=db_password

# hwins データルート配下にデータディレクトリを永続化します (SELinux relabel は :Z)。
Volume=/opt/hwins/data/postgres/18:/var/lib/postgresql:Z

Timezone=Asia/Tokyo

HealthCmd=pg_isready -U redmine -d redmine -q
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
