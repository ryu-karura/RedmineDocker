# quadlets/redmine.network
#
# Podman Quadlet network definition for all Redmine containers.
# Place this file in /etc/containers/systemd/redmine.network
# and run: systemctl daemon-reload
#
# This creates a dedicated bridge network so containers can communicate
# by hostname. The database port (5432) is NOT exposed to the host.

[Network]
NetworkName=redmine_net
Driver=bridge
Subnet=10.89.1.0/24
Gateway=10.89.1.1

[Install]
WantedBy=multi-user.target
