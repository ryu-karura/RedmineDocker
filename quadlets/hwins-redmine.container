# quadlets/hwins-redmine.container
#
# hwins-redmine 用の Podman Quadlet ユニットです: Redmine 6.1.3 + plugin stack (Puma :3000)。
# /etc/containers/systemd/hwins-redmine.container に配置し、次を実行します:
#   systemctl daemon-reload && systemctl start hwins-redmine
#
# DB パスワードと secret_key_base は Podman シークレットです（docs/Setup.md 参照）。
# Puma のポート 3000 は公開せず、hwins-net 上で hwins-static だけが到達します。
# SMTP 設定（あれば）には下の EnvironmentFile を使います。

[Unit]
Description=hwins Redmine アプリケーション 6.1.3
Documentation=file:///opt/hwins/containers/docs/Design.md
After=network-online.target hwins-db.service
Wants=network-online.target
Requires=hwins-db.service

[Container]
Image=localhost/hwins-redmine:6.1.3
ContainerName=hwins-redmine
Network=hwins-net

Environment=RAILS_ENV=production
Environment=RAILS_RELATIVE_URL_ROOT=/redmine
Environment=REDMINE_DB_HOST=hwins-db
Environment=REDMINE_DB_NAME=redmine
Environment=REDMINE_DB_USER=redmine
Environment=REDMINE_DB_PASSWORD_FILE=/run/secrets/db_password
Environment=REDMINE_SECRET_KEY_BASE_FILE=/run/secrets/secret_key_base
Environment=REDMINE_PLUGINS_MIGRATE=1
# オプションの非シークレット設定（SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD）。
# 先頭の '-' はファイルが存在しなくても無視するための指定です。
EnvironmentFile=-/opt/hwins/containers/.env

Secret=db_password,type=mount,target=db_password
Secret=secret_key_base,type=mount,target=secret_key_base

# アップロードした添付ファイルとログを hwins データルート配下に永続化します。
Volume=/opt/hwins/data/redmine/files:/usr/src/redmine/files:Z
Volume=/opt/hwins/data/redmine/log:/usr/src/redmine/log:Z

Timezone=Asia/Tokyo

HealthCmd=curl -f -s http://localhost:3000/redmine/login > /dev/null
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=180s

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
