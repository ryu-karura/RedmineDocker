# /etc/logrotate.d/hwins-redmine
#
# Log rotation configuration for the hwins Redmine stack.
# Retains logs for 60 days using daily rotation.
#
# Install with: sudo cp /opt/hwins/containers/logrotate/redmine /etc/logrotate.d/hwins-redmine
# Test with:    sudo logrotate --debug /etc/logrotate.d/hwins-redmine
# Force run:    sudo logrotate --force /etc/logrotate.d/hwins-redmine
#
# The Redmine application log is written inside the hwins-redmine container to
# /usr/src/redmine/log, which is bind-mounted to the host path below. copytruncate
# is used because the log file is held open by the Puma process in the container;
# this avoids needing to signal the process or match its (namespaced) uid/gid.

# ── Redmine application log ───────────────────────────────────────────────────
/opt/hwins/data/redmine/log/production.log {
    daily
    rotate 60
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d
}

# ── Host Apache logs (front reverse proxy) ────────────────────────────────────
/var/log/httpd/redmine_access.log
/var/log/httpd/redmine_error.log {
    daily
    rotate 60
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    dateext
    dateformat -%Y%m%d
    create 0640 root root
    postrotate
        # Signal Apache to reopen its log files
        /usr/bin/systemctl reload httpd 2>/dev/null || true
    endscript
}
