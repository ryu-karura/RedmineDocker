# ── Version upgrade test environment logs ────────────────────────────────────
/opt/redmine/data/redmine3/log/production.log
/opt/redmine/data/redmine3/log/puma.log
/opt/redmine/data/redmine3/log/puma_error.log {
    daily
    rotate 60
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d
    create 0644 redmine_adm redmine
