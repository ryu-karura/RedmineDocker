# /etc/logrotate.d/redmine-web
#
# Log rotation configuration for the redmine Redmine stack.
# Retains logs for 60 days using daily rotation.
#
# Install with: sudo cp /opt/redmine/containers/logrotate/redmine /etc/logrotate.d/redmine-web
# Test with:    sudo logrotate --debug /etc/logrotate.d/redmine-web
# Force run:    sudo logrotate --force /etc/logrotate.d/redmine-web
#
# NOTE: with the official image's default RAILS_LOG_TO_STDOUT=true, Redmine
# logs to the container's stdout and never writes log/production.log — those
# logs are read with `docker compose logs redmine-web` and rotated by the
# docker log driver instead. The first stanza below therefore only does
# something if file logging is turned back on (set RAILS_LOG_TO_STDOUT= in
# .env); until then `missingok` makes it a no-op. See docs/Manual.md, "ログ".
#
# When it is enabled, the application log is written inside the redmine-web
# container to /usr/src/redmine/log, which is bind-mounted to the host path
# below by compose.prod.yaml. copytruncate is used because the log file is held
# open by the app process in the container (Passenger or Puma); this avoids
# needing to signal the process or match its uid/gid.

# ── Redmine application log ───────────────────────────────────────────────────
/opt/redmine/data/redmine/log/production.log {
    daily
    rotate 60
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d
}

# ── Host Apache logs (front reverse proxy) ────────────────────────────────────
/var/log/httpd/redmine_access.log
/var/log/httpd/redmine_error.log {
    daily
    rotate 60
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    dateext
    dateformat -%Y%m%d
    create 0640 root root
    postrotate
        # Signal Apache to reopen its log files
        /usr/bin/systemctl reload httpd 2>/dev/null || true
    endscript
}
