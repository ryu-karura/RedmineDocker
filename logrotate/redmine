# ── Host Apache logs ──────────────────────────────────────────────────────────
/var/log/httpd/redmine_access.log
/var/log/httpd/redmine_error.log {
    daily
    rotate 60
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    dateext
    dateformat -%Y%m%d
    create 0640 root root
    postrotate
        # Signal Apache to reopen its log files
        /usr/bin/systemctl reload httpd 2>/dev/null || true
    endscript
}
