# Docker3: Version Upgrade and Testing Environment
#
# Purpose: Test the upcoming Redmine version (main branch / 7.0-dev) against
# production-equivalent data before upgrading Docker1.
#
# Key differences from Docker1:
#   - Redmine source: git clone from main branch (development/pre-release)
#   - Sub-URI: /redmine-next
#   - Database: redmine_next
#   - Host port: 10082 → 80
#   - Image tag: localhost/redmine-next:dev
#
# IMPORTANT NOTES:
#   - This environment intentionally runs pre-release Redmine code.
#   - Not all plugins may be compatible with the next version.
#     Incompatible plugins are excluded from this build (commented out).
#   - The redmine_gtt plugin may need special attention for major version upgrades.
#   - Rebuild this image regularly (weekly) to track upstream changes:
#     podman build --no-cache -t localhost/redmine-next:dev containers/docker3/

FROM docker.io/almalinux:9.5

ARG RUBY_VERSION=3.4.4
ARG BUNDLER_VERSION=2.6.8
ARG NODE_MAJOR=22
ARG REDMINE_GIT_BRANCH=main
ARG RAILS_ENV=production
ARG REDMINE_SUBURI=/redmine-next

ENV RUBY_VERSION=${RUBY_VERSION}
ENV BUNDLER_VERSION=${BUNDLER_VERSION}
ENV RAILS_ENV=${RAILS_ENV}
ENV RAILS_RELATIVE_URL_ROOT=${REDMINE_SUBURI}
ENV RBENV_ROOT=/usr/local/rbenv
ENV PATH=${RBENV_ROOT}/bin:${RBENV_ROOT}/shims:${PATH}
ENV REDMINE_HOME=/opt/redmine/app
ENV REDMINE_SUBURI=${REDMINE_SUBURI}

# ── System packages (identical to Docker1/2) ─────────────────────────────────
RUN dnf install -y epel-release \
    && dnf install -y \
        https://download.postgresql.org/pub/repos/yum/reporpms/EL-9-x86_64/pgdg-redhat-repo-latest.noarch.rpm \
    && dnf -qy module disable postgresql \
    && dnf install -y \
        gcc gcc-c++ make git curl wget tar bzip2 patch \
        openssl-devel readline-devel zlib-devel libffi-devel \
        libyaml-devel gdbm-devel ncurses-devel \
        libpq-devel postgresql17-devel \
        ImageMagick ImageMagick-devel \
        httpd mod_ssl \
        sudo tzdata findutils which \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# ── Install Node.js 22.x LTS ──────────────────────────────────────────────────
RUN curl -fsSL https://rpm.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && dnf install -y nodejs \
    && dnf clean all \
    && npm install -g yarn@1.22.22

# ── Install Ruby 3.4.4 via rbenv ──────────────────────────────────────────────
RUN git clone https://github.com/rbenv/rbenv.git ${RBENV_ROOT} \
    && git clone https://github.com/rbenv/ruby-build.git ${RBENV_ROOT}/plugins/ruby-build \
    && rbenv install ${RUBY_VERSION} \
    && rbenv global ${RUBY_VERSION} \
    && rbenv rehash \
    && gem install bundler:${BUNDLER_VERSION} --no-document

# ── Create redmine_adm user ────────────────────────────────────────────────────
RUN groupadd --gid 1001 redmine \
    && useradd --uid 1001 --gid 1001 \
        --home /opt/redmine \
        --no-create-home \
        --shell /sbin/nologin \
        redmine_adm

# ── Clone Redmine from main branch (development/pre-release) ─────────────────
# Using git clone instead of tarball to track the latest development code.
# The --depth 1 flag avoids downloading full git history for faster builds.
RUN mkdir -p /opt/redmine \
    && git clone --depth 1 --branch ${REDMINE_GIT_BRANCH} \
        https://github.com/redmine/redmine.git \
        /opt/redmine/app \
    && mkdir -p \
        /opt/redmine/app/tmp/pids \
        /opt/redmine/app/tmp/cache \
        /opt/redmine/app/log \
        /opt/redmine/app/public/plugin_assets \
        /opt/redmine/app/public/assets \
    && chown -R redmine_adm:redmine /opt/redmine/app \
    && chmod -R 755 /opt/redmine/app

# ── Copy configuration files ──────────────────────────────────────────────────
COPY --chown=redmine_adm:redmine database.yml.tmpl \
    /opt/redmine/app/config/database.yml.tmpl
COPY --chown=redmine_adm:redmine configuration.yml.tmpl \
    /opt/redmine/app/config/configuration.yml.tmpl
COPY --chown=redmine_adm:redmine puma.rb \
    /opt/redmine/app/config/puma.rb

# ── Install plugins (only confirmed-compatible plugins) ───────────────────────
# NOTE: Some plugins may not work with the next major Redmine version.
# Comment out any plugin that fails to load on the new version during testing.
# Do NOT blindly include all plugins from Docker1 — validate each one.
WORKDIR /opt/redmine/app/plugins

RUN git clone --depth 1 \
        https://github.com/farend/redmine_theme_farend_fancy.git \
        /opt/redmine/app/themes/farend_fancy

# Include plugins with confirmed broad compatibility
RUN git clone --depth 1 --branch 1.2.1 \
        https://github.com/redmica/redmine_issues_panel.git \
        redmine_issues_panel

RUN git clone --depth 1 --branch 0.6.0 \
        https://github.com/redmica/redmica_ui_extension.git \
        redmica_ui_extension

RUN git clone --depth 1 --branch 1.1.1 \
        https://github.com/redmica/redmine_ip_filter.git \
        redmine_ip_filter

RUN git clone --depth 1 --branch 1.1.0 \
        https://github.com/redmica/redmine_message_customize.git \
        redmine_message_customize

RUN git clone --depth 1 \
        https://github.com/onozaty/redmine-view-customize.git \
        view_customize

RUN git clone --depth 1 --branch 0.4.0 \
        https://github.com/haru/redmine_logs.git \
        redmine_logs

RUN git clone --depth 1 --branch 1.2.0 \
        https://github.com/haru/redmine_wiki_extensions.git \
        redmine_wiki_extensions

RUN git clone --depth 1 --branch 1.0.0 \
        https://github.com/nishidayuya/redmine_solid_queue.git \
        redmine_solid_queue \
    || git clone --depth 1 \
        https://github.com/nishidayuya/redmine_solid_queue.git \
        redmine_solid_queue

# redmine_gtt: include if major version has PostGIS schema compatibility
# Comment out if redmine_gtt is not yet updated for the new Redmine major version
RUN git clone --depth 1 --branch 6.0.3 \
        https://github.com/gtt-project/redmine_gtt.git \
        redmine_gtt

# Plugins to test during upgrade validation (add here, not in Docker1)
# RUN git clone --depth 1 https://github.com/example/next-plugin.git next_plugin

# ── Bundle install ────────────────────────────────────────────────────────────
WORKDIR /opt/redmine/app
USER redmine_adm

RUN bundle config set --local without 'development test' \
    && bundle install --jobs 4 --retry 3

# ── Build redmine_gtt frontend ────────────────────────────────────────────────
RUN cd /opt/redmine/app/plugins/redmine_gtt \
    && yarn install --frozen-lockfile \
    && npx webpack --mode production

USER root
RUN chown -R redmine_adm:redmine /opt/redmine/app

# ── Configure Apache ──────────────────────────────────────────────────────────
RUN rm -f /etc/httpd/conf.d/welcome.conf \
       /etc/httpd/conf.d/ssl.conf \
       /etc/httpd/conf.d/autoindex.conf

COPY apache/httpd.conf /etc/httpd/conf/httpd.conf
COPY apache/redmine-next.conf /etc/httpd/conf.d/redmine.conf

RUN chown -R root:redmine /opt/redmine/app/public \
    && chmod -R 755 /opt/redmine/app/public

COPY entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

EXPOSE 80

VOLUME ["/opt/redmine/app/files", "/opt/redmine/app/log", \
        "/opt/redmine/app/public/assets", "/opt/redmine/app/public/plugin_assets", \
        "/opt/redmine/app/tmp"]

ENTRYPOINT ["/entrypoint.sh"]
