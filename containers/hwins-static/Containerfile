# hwins-static: Apache httpd 2.4 reverse proxy / public web tier
#
# Base image: docker.io/library/httpd:2.4
#
# This is the only container published to the host (127.0.0.1:18080). It
# reverse-proxies the Redmine sub-URI to hwins-redmine's Puma on :3000. Redmine
# serves its own static assets on that port (the official image does so out of
# the box), so this tier needs no shared volume.
#
# ── Digest pinning ────────────────────────────────────────────────────────────
# Per issue #18 the httpd base image must be pinned by digest AFTER pulling it.
# This repository ships the moving `2.4` tag so the image builds anywhere; run
#   scripts/pin-static-image.sh
# on a networked host to resolve the current digest and rewrite the FROM line to
#   FROM docker.io/library/httpd:2.4@sha256:<digest>
FROM docker.io/library/httpd:2.4

# Enable the modules required for the reverse proxy and drop in our vhost.
# Use the absolute config path so the build does not depend on the base image's
# default WORKDIR. The Include directive is resolved by Apache relative to
# ServerRoot (/usr/local/apache2) at runtime, so it stays relative.
RUN set -eux; \
    conf=/usr/local/apache2/conf/httpd.conf; \
    sed -i \
        -e 's|^#\(LoadModule proxy_module .*\)|\1|' \
        -e 's|^#\(LoadModule proxy_http_module .*\)|\1|' \
        -e 's|^#\(LoadModule headers_module .*\)|\1|' \
        -e 's|^#\(LoadModule rewrite_module .*\)|\1|' \
        "$conf"; \
    printf '\nInclude conf/redmine-proxy.conf\n' >> "$conf"

COPY httpd-redmine.conf /usr/local/apache2/conf/redmine-proxy.conf

EXPOSE 80
