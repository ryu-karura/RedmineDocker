# containers/redmine-web/database.yml.tmpl
#
# Redmine database configuration template, rendered by entrypoint.sh with
# envsubst before Puma starts.
#
# IMPORTANT: the adapter is 'postgis' (not 'postgresql'). This is REQUIRED by
# the redmine_gtt (Geo-Task-Tracker) plugin. Using 'postgresql' with redmine_gtt
# installed causes ActiveRecord adapter errors at startup — which is why we
# render this ourselves instead of relying on the official image's env-driven
# database.yml (that image only knows the 'postgresql' adapter).
#
# Substituted variables:
#   ${REDMINE_DB_HOST}     → database container hostname (redmine-db)
#   ${REDMINE_DB_NAME}     → database name (redmine)
#   ${REDMINE_DB_USER}     → database username (redmine)
#   ${REDMINE_DB_PASSWORD} → database password (from a Docker/Podman secret)

production:
  adapter: postgis
  host: ${REDMINE_DB_HOST}
  port: 5432
  database: ${REDMINE_DB_NAME}
  username: ${REDMINE_DB_USER}
  password: ${REDMINE_DB_PASSWORD}
  encoding: utf8
  pool: 10
  # PostGIS schema search path
  schema_search_path: public,topology
  # Connection behaviour
  checkout_timeout: 5
  connect_timeout: 5
  idle_timeout: 300
  prepared_statements: false
