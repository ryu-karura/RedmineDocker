# containers/redmine-web/database.yml.tmpl
#
# entrypoint.sh が Puma 起動前に envsubst で描画する
# Redmine DB 設定テンプレートです。
#
# 重要: adapter は 'postgresql' ではなく 'postgis' です。
# これは redmine_gtt（Geo-Task-Tracker）で必須です。
# redmine_gtt 導入環境で 'postgresql' を使うと起動時に
# ActiveRecord アダプタエラーになるため、公式イメージの
# 環境変数駆動 database.yml（postgresql 前提）を使わず
# 本テンプレートを描画しています。
#
# 置換変数:
#   ${REDMINE_DB_HOST}     → DB コンテナホスト名（redmine-db）
#   ${REDMINE_DB_NAME}     → DB 名（redmine）
#   ${REDMINE_DB_USER}     → DB ユーザー名（redmine）
#   ${REDMINE_DB_PASSWORD} → DB パスワード（Docker/Podman シークレット）

production:
  adapter: postgis
  host: ${REDMINE_DB_HOST}
  port: 5432
  database: ${REDMINE_DB_NAME}
  username: ${REDMINE_DB_USER}
  password: ${REDMINE_DB_PASSWORD}
  encoding: utf8
  pool: 10
  # PostGIS スキーマ検索パス
  schema_search_path: public,topology
  # 接続関連パラメータ
  checkout_timeout: 5
  connect_timeout: 5
  idle_timeout: 300
  prepared_statements: false
