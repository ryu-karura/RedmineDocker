# containers/redmine-web/httpd-redmine.conf
#
# 統合 redmine-web コンテナ用のリバースプロキシ VirtualHost テンプレートです。
# Apache 起動前に entrypoint.sh が envsubst で描画します。
# Redmine サブ URI（${RAILS_RELATIVE_URL_ROOT}）を公開し、
# 127.0.0.1:${REDMINE_PUMA_PORT} の Puma へ転送します。

# "could not reliably determine the server's fully qualified domain name"
# 警告を抑止し、バージョン情報露出を抑えます。
ServerName localhost
ServerTokens Prod
ServerSignature Off

<VirtualHost *:80>
    ServerName localhost

    ProxyRequests Off
    ProxyPreserveHost On

    # 手前の host Apache が設定したスキーム（X-Forwarded-Proto: https）を保持します。
    # 値が無い場合のみ http を補完（例: 開発でコンテナ :80 へ直接アクセス）し、
    # 実際の https 値を上書きしないようにします
    # （絶対 URL や secure cookie の破損防止）。
    # mod_proxy_http はこのホップを X-Forwarded-For へ自動追記するため、
    # redmine_ip_filter でも上流のクライアントアドレスを参照できます。
    RequestHeader setifempty X-Forwarded-Proto "http"

    # 利便性のため、/ へ来たアクセスを Redmine サブ URI へリダイレクトします。
    RedirectMatch ^/$ ${RAILS_RELATIVE_URL_ROOT}/

    # Redmine サブ URI を Puma へ転送します。
    # CSS/JS/テーマなど静的資産もこのポートで Redmine 側が配信します。
    ProxyPass        ${RAILS_RELATIVE_URL_ROOT}  http://127.0.0.1:${REDMINE_PUMA_PORT}${RAILS_RELATIVE_URL_ROOT}
    ProxyPassReverse ${RAILS_RELATIVE_URL_ROOT}  http://127.0.0.1:${REDMINE_PUMA_PORT}${RAILS_RELATIVE_URL_ROOT}

    # ── セキュリティヘッダー ───────────────────────────────────────────────────
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options        "SAMEORIGIN"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"

    # ── ログ出力先（container stdout/stderr） ─────────────────────────────────
    ErrorLog  /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined
</VirtualHost>
