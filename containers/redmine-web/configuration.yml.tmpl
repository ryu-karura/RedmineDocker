# containers/redmine-web/configuration.yml.tmpl
#
# entrypoint.sh が Puma 起動前に envsubst で描画する
# Redmine アプリ設定テンプレートです。
#
# 置換変数:
#   ${SMTP_HOST}     → SMTP サーバーホスト名
#   ${SMTP_PORT}     → SMTP サーバーポート
#   ${SMTP_USER}     → SMTP ユーザー名
#   ${SMTP_PASSWORD} → SMTP パスワード

default:
  # ── メール配信 ─────────────────────────────────────────────────────────────
  email_delivery:
    delivery_method: :smtp
    smtp_settings:
      address: "${SMTP_HOST}"
      port: ${SMTP_PORT}
      authentication: :login
      user_name: "${SMTP_USER}"
      password: "${SMTP_PASSWORD}"
      enable_starttls_auto: true

  # ── 添付ファイル ───────────────────────────────────────────────────────────
  # 保存先（Redmine ルート相対）と最大サイズ（KB、50MB）
  attachments_storage_path: files
  max_attachment_size: 51200

  # ── セッション ─────────────────────────────────────────────────────────────
  session_store: :active_record_store

  # ── ログ ───────────────────────────────────────────────────────────────────
  log_level: info

  # ── SCM（バージョン管理） ─────────────────────────────────────────────────
  scm_git_command: /usr/bin/git
  scm_subversion_command: /usr/bin/svn

production:
  # default の設定を継承します。
  # 必要に応じて本番専用上書きを追加してください。
