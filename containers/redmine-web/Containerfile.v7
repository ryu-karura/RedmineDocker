# redmine-web (Redmine 7 系): Redmine 7.0.0（公式イメージ）+ プラグイン/テーマ一式
#
# シリーズ別 Containerfile のうち Redmine 7 用です。
# 5 系は Containerfile.v5、6 系（既定）は Containerfile.v6 を参照してください。
# 切り替えは .env の REDMINE_WEB_CONTAINERFILE / REDMINE_VERSION で行います
# （docs/Design.md「Redmine シリーズの切り替え」参照）。
#
# ベースイメージ: docker.io/library/redmine:7.0.0
#   ruby:4.0-slim-trixie ベース / Rails 8.1.3
#   （Redmine 7.0.0 の Gemfile は ruby '>= 3.2.0', '< 4.1.0'、公式イメージは Ruby 4.0）
#
# 公式イメージに対して次を追加します:
#   - 日本語 CJK フォント（fonts-noto-cjk）
#   - RedmineDocker のプラグイン/テーマ構成（13 plugins + farend_fancy）
#
# アプリ配置は /usr/src/redmine（公式イメージ標準）です。
# Apache が :80 で受け、REDMINE_WEB_SERVER に応じて次のどちらかで処理します:
#   puma      (既定) 内部の Puma（:3000）へ ProxyPass
#   passenger mod_passenger が Redmine を直接起動（:3000 は使わない）
#
# ★ mod_passenger は forky (Debian 14) から導入します（7 系のみ）
#   このイメージのベースは Ruby 4.0 です。Debian trixie の
#   libapache2-mod-passenger は 6.0.26 で、Passenger が Ruby 4 対応に言及した
#   のは 6.1.1（CHANGELOG: "[Ruby] Improve support for Ruby 4 and Frozen String
#   Literals"）以降のため、trixie のパッケージでは Ruby 4 対応が入りません。
#   そこで 7 系だけ、forky (Debian 14 / testing) の Passenger 6.1.x を
#   APT pin で導入します（5 / 6 系は Ruby 3.4 なので trixie の 6.0.26 のまま）。
#   pin は passenger 関連パッケージのみ 990、それ以外の forky パッケージは
#   -10（= インストール禁止）にしてあるので、libc6 等が forky へ引きずられる
#   部分アップグレードは起こりません。依存ライブラリが trixie 側で満たせない
#   場合は、黙って混ざらずにビルドがその場で失敗します。
#   導入後に 6.1 以上であることを dpkg --compare-versions で検証しており、
#   forky 側が 6.1 未満へ戻った場合もビルドが失敗します。
#
# サブ URI: /redmine（RAILS_RELATIVE_URL_ROOT）
#
# 導入プラグイン（13）:
#   1.  redmine_wiki_lists        (tkusukawa, 0.0.11)
#   2.  redmine_issues_panel      (redmica, v1.2.1)
#   3.  redmica_ui_extension      (redmica, v0.6.0)
#   4.  redmine_ip_filter         (redmica, v1.2.0)
#   5.  redmine_message_customize (redmica/farend, v1.1.0)
#   6.  redmine_issue_templates   (redmica, master = 1.2.2)
#   7.  view_customize            (onozaty, v3.6.0、ディレクトリ名は必ず 'view_customize')
#   8.  redmine_logs              (haru, 0.4.0)
#   9.  redmine_login_audit2      (seraph3000, 1.0.2 ← タグに v 接頭辞なし)
#  10.  redmine_wiki_extensions   (haru, 1.3.0)
#  11.  redmine_solid_queue       (nishidayuya, v1.0.0)
#  12.  redmine_gtt               (gtt-project, v7.1.0) ← PostGIS が必要
#  13.  redmine_xlsx_format_issue_exporter (two-pack, 0.2.1) — 課題一覧などの
#       XLSX 出力。requires_redmine 4.2 以上（上限指定なし）。最終タグは
#       2024-01 で、7 系リリース（2026）より前のため CI 実績はありません。
#       事前検証推奨。
#
# 6 系にあって 7 系で外したプラグイン:
#   - redmine_banner … master は Redmine 7 未対応です。7.0 向け修正は
#     未マージのブランチ test_fix_for_redmine_7_0（2026-07-21/22、
#     config/routes.rb 修正）にのみ存在し、リリースタグにも master にも
#     入っていないため、対応が取り込まれるまで同梱しません。
#
# テーマ: farend_fancy（farend、既定ブランチ master）

ARG WEB_BASE_IMAGE=docker.io/library/redmine:7.0.0
FROM ${WEB_BASE_IMAGE}

ARG REDMINE_HOME=/usr/src/redmine
ENV REDMINE_HOME=${REDMINE_HOME}
ENV RAILS_ENV=production
ENV RAILS_RELATIVE_URL_ROOT=/redmine
# Redmine はアプリポートで静的資産も配信します。
# このコンテナ内の Apache フロントはそこへ転送します。
ENV RAILS_SERVE_STATIC_FILES=1
# アプリサーバーの既定は puma（Apache -> ProxyPass -> Puma :3000）。
# passenger にすると Apache + mod_passenger が Redmine を直接起動します
# （7 系の mod_passenger は上記★のとおり forky の 6.1.x）。
ENV REDMINE_WEB_SERVER=puma

# ── システムパッケージ（root） ────────────────────────────────────────────────
USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
                # PDF/Gantt 出力向け日本語フォント, OpenDocument
        fonts-noto-cjk fontconfig pandoc \
                # プラグインのビルド/実行ツール
        git \
                # postgis アダプタ系 native gem のビルド依存:
                #   rgeo → GEOS/PROJ（libgeos-dev, libproj-dev）
                #   pg   → libpq/pg_config（libpq-dev が /usr/bin/pg_config を提供）
                # postgresql-client 単体では pg_config が入らないため、
                # libpq-dev がないと `bundle install` で pg のビルドが失敗します。
        libgeos-dev libproj-dev libpq-dev build-essential pkg-config \
                # entrypoint 補助: envsubst（テンプレート描画）+ pg_isready（DB待機）
        gettext-base postgresql-client \
                # コンテナヘルスチェック + Apache フロント
        curl apache2 \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -fv

# ── mod_passenger（REDMINE_WEB_SERVER=passenger 用） ──────────────────────────
# 先頭の★のとおり、7 系は Ruby 4.0 のため trixie の 6.0.26 ではなく
# forky (Debian 14 / testing) の Passenger 6.1.x を導入します。
#
# APT pin の意図:
#   Package: *                              … forky 由来は既定で -10（導入禁止）
#   Package: passenger 系                   … 990（trixie の 500 より優先）
# これにより forky から来るのは passenger 関連パッケージだけになり、依存が
# trixie で満たせない場合はビルドが失敗します（部分アップグレードは起きません）。
# sources.list / preferences は同じ RUN 内で削除し、実行時の apt に forky が
# 残らないようにします。
ARG PASSENGER_APT_SUITE=forky
ARG PASSENGER_MIN_VERSION=6.1
RUN set -eux; \
    echo "deb http://deb.debian.org/debian ${PASSENGER_APT_SUITE} main" \
        > /etc/apt/sources.list.d/passenger-suite.list; \
    { \
        echo 'Package: *'; \
        echo "Pin: release n=${PASSENGER_APT_SUITE}"; \
        echo 'Pin-Priority: -10'; \
        echo ''; \
        echo 'Package: passenger passenger-* libapache2-mod-passenger ruby-passenger'; \
        echo "Pin: release n=${PASSENGER_APT_SUITE}"; \
        echo 'Pin-Priority: 990'; \
    } > /etc/apt/preferences.d/passenger-suite.pref; \
    apt-get update; \
    apt-get install -y --no-install-recommends libapache2-mod-passenger; \
    passenger_version="$(dpkg-query -W -f='${Version}' libapache2-mod-passenger)"; \
    echo "installed libapache2-mod-passenger: ${passenger_version}"; \
    if ! dpkg --compare-versions "${passenger_version}" ge "${PASSENGER_MIN_VERSION}"; then \
        echo "ERROR: libapache2-mod-passenger ${passenger_version} < ${PASSENGER_MIN_VERSION}:" >&2; \
        echo "       Ruby 4 support landed in Passenger 6.1.1. Check that suite" >&2; \
        echo "       '${PASSENGER_APT_SUITE}' still ships 6.1 or newer." >&2; \
        exit 1; \
    fi; \
    rm -f /etc/apt/sources.list.d/passenger-suite.list \
          /etc/apt/preferences.d/passenger-suite.pref; \
    rm -rf /var/lib/apt/lists/*

# ── プラグインとテーマ ─────────────────────────────────────────────────────────
# 全プラグインはビルド時に取得してイメージへ焼き込みます（再現性確保）。
# 更新時はイメージを再ビルドしてください。

# テーマ farend_fancy: 既定ブランチ（master）から clone。
# Redmine 6.0 以降 themes/ を参照します（5.1 以前は public/themes/）。
RUN git clone --depth 1 \
        https://github.com/farend/redmine_theme_farend_fancy.git \
        ${REDMINE_HOME}/themes/farend_fancy

WORKDIR ${REDMINE_HOME}/plugins

# 1. redmine_wiki_lists (0.0.11) — Wiki マクロプラグイン
#    宣言は requires_redmine 3.4 以上ですが、最終更新は 2021 年で
#    Redmine 7 での検証実績はありません。事前検証推奨。
RUN git clone --depth 1 --branch 0.0.11 \
        https://github.com/tkusukawa/redmine_wiki_lists.git redmine_wiki_lists \
    || git clone --depth 1 \
        https://github.com/tkusukawa/redmine_wiki_lists.git redmine_wiki_lists

# 2. redmine_issues_panel (1.2.1) — かんばん風課題パネル
#    CI が redmine/redmine master（= 7.0-devel）を対象にしています。
RUN git clone --depth 1 --branch v1.2.1 \
        https://github.com/redmica/redmine_issues_panel.git redmine_issues_panel

# 3. redmica_ui_extension (0.6.0) — UI 拡張（Select2, mermaid, burndown）
#    CI が redmine/redmine master（= 7.0-devel）を対象にしています。
RUN git clone --depth 1 --branch v0.6.0 \
        https://github.com/redmica/redmica_ui_extension.git redmica_ui_extension

# 4. redmine_ip_filter (1.2.0) — IP ベースアクセス制御
#    6 系の v1.1.1 より新しく、CI が redmine/redmine master を対象にしています。
RUN git clone --depth 1 --branch v1.2.0 \
        https://github.com/redmica/redmine_ip_filter.git redmine_ip_filter

# 5. redmine_message_customize (1.1.0) — UI 文字列カスタマイズ
#    最終更新は 2024-11 で、Redmine 7 に対する CI 実績はありません
#    （宣言は requires_redmine 6.0 以上）。事前検証推奨。
RUN git clone --depth 1 --branch v1.1.0 \
        https://github.com/redmica/redmine_message_customize.git redmine_message_customize

# 6. redmine_issue_templates (master = 1.2.2) — 課題テンプレート
#    "Load legacy-icons-compat.css to keep raster icons visible on Redmine 7.0
#    and later" のコミットが入っており、7.0 を意識した対応が済んでいます。
RUN git clone --depth 1  \
        https://github.com/redmica/redmine_issue_templates.git redmine_issue_templates

# 7. view_customize (3.6.0) — ディレクトリ名は必ず 'view_customize'（init.rb の要件）
#    "Avoid Redmine 7.0 ActiveSupport::Configurable deprecation warning" 対応済み。
RUN git clone --depth 1 --branch v3.6.0 \
        https://github.com/onozaty/redmine-view-customize.git view_customize \
    || git clone --depth 1 \
        https://github.com/onozaty/redmine-view-customize.git view_customize

# 8. redmine_logs (0.4.0) — 管理画面ログビューア
#    CI の対象は 6.0-stable / 6.1-stable / master（2025 年時点）で、
#    7.0-stable は含まれていません。事前検証推奨。
RUN git clone --depth 1 --branch 0.4.0 \
        https://github.com/haru/redmine_logs.git redmine_logs

# 9. redmine_login_audit2 (1.0.2) — ログイン/API 監査ログ
#    "v1.0.2: Redmine 7.0 support; migrate filters to core Query API" 対応版。
#    このリポジトリのタグは v1.0.0 と 1.0.2 で接頭辞が揺れているため、
#    1.0.2 は v なしで指定します。
RUN git clone --depth 1 --branch 1.0.2 \
        https://github.com/seraph3000/redmine_login_audit2.git redmine_login_audit2 \
    || git clone --depth 1 \
        https://github.com/seraph3000/redmine_login_audit2.git redmine_login_audit2

# 10. redmine_wiki_extensions (1.3.0) — Wiki 拡張（マクロ、コメント、タグ、投票）
#     CI マトリクスに 7.0-stable と ruby 4.0 が含まれています。
RUN git clone --depth 1 --branch 1.3.0 \
        https://github.com/haru/redmine_wiki_extensions.git redmine_wiki_extensions

# 11. redmine_solid_queue (1.0.0) — Redmine バックグラウンドジョブに Solid Queue を利用
#     init.rb に requires_redmine の宣言がなく、CI もありません。solid_queue gem
#     自体は activerecord >= 7.1 要求のため Rails 8.1 で解決可能です。事前検証推奨。
RUN git clone --depth 1 --branch v1.0.0 \
        https://github.com/nishidayuya/redmine_solid_queue.git redmine_solid_queue \
    || git clone --depth 1 \
        https://github.com/nishidayuya/redmine_solid_queue.git redmine_solid_queue

# 12. redmine_gtt (7.1.0) — Geo-Task-Tracker（PostGIS が必要）
#     CI マトリクスに redmine 7.0-stable × ruby 3.4 / 4.0 が含まれています。
#     他のプラグインと違い git clone ではなくリリース tarball を展開します:
#     gtt 7.0 でフロントエンドが webpack+yarn から Vite+pnpm へ移行し、
#     ソースビルドには Node >= 22 と corepack/pnpm が必要になりました
#     （Debian trixie の nodejs は 20.19 で要件を満たしません）。
#     リリース tarball には assets/javascripts/main.js と
#     assets/stylesheets/main.css がビルド済みで同梱されています。
ARG GTT_VERSION=v7.1.0
RUN curl -fsSL -o /tmp/redmine_gtt.tar.gz \
        "https://github.com/gtt-project/redmine_gtt/releases/download/${GTT_VERSION}/redmine_gtt-${GTT_VERSION}.tar.gz" \
    && tar -xzf /tmp/redmine_gtt.tar.gz -C . \
    && rm -f /tmp/redmine_gtt.tar.gz \
    && test -f redmine_gtt/assets/javascripts/main.js

# 13. redmine_xlsx_format_issue_exporter (0.2.1) — 課題一覧などの XLSX 出力
#     requires_redmine 4.2 以上（上限指定なし）。最終タグは 2024-01 で、
#     7 系リリース（2026）より前のため CI 実績はありません。事前検証推奨。
RUN git clone --depth 1 --branch 0.2.1 \
        https://github.com/two-pack/redmine_xlsx_format_issue_exporter.git redmine_xlsx_format_issue_exporter \
    || git clone --depth 1 \
        https://github.com/two-pack/redmine_xlsx_format_issue_exporter.git redmine_xlsx_format_issue_exporter

# ── プラグイン gem のインストール ─────────────────────────────────────────────
# プラグイン依存 gem をイメージ内 bundle（/usr/local/bundle）へ焼き込みます。
# gtt の Gemfile は Rails のバージョンに応じて geo gem スタックを自動解決します
# （Rails 8.1 → activerecord-postgis-adapter 11.1.x + rgeo-activerecord 8.1.x）。
WORKDIR ${REDMINE_HOME}
RUN bundle install --jobs 4 --retry 3 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# ── 設定テンプレートと entrypoint ──────────────────────────────────────────────
COPY database.yml.tmpl ${REDMINE_HOME}/config/database.yml.tmpl
COPY configuration.yml.tmpl ${REDMINE_HOME}/config/configuration.yml.tmpl
# stock の config.ru を置き換え、Puma 側で
# RAILS_RELATIVE_URL_ROOT (/redmine) を正しく mount させます。
# 理由は config.ru のコメントを参照してください。
COPY config.ru ${REDMINE_HOME}/config.ru
COPY httpd-redmine.conf.tmpl /etc/apache2/conf-available/redmine-proxy.conf.tmpl
COPY httpd-redmine-passenger.conf.tmpl /etc/apache2/conf-available/redmine-passenger.conf.tmpl
COPY entrypoint.sh /usr/local/bin/redmine-entrypoint.sh
COPY healthcheck.sh /usr/local/bin/redmine-healthcheck.sh
RUN a2enmod headers rewrite proxy proxy_http \
    # mod_passenger は Debian パッケージの postinst が有効化しますが、
    # 既定モード (puma) では不要なのでここで無効化しておきます。
    # entrypoint.sh が REDMINE_WEB_SERVER に応じて起動時に切り替えます。
    && a2dismod -f passenger \
    && a2dissite 000-default || true \
    # Build-time default render, purely so a2enconf has a file to enable;
    # entrypoint.sh re-renders this from the .tmpl at container start in case
    # RAILS_RELATIVE_URL_ROOT was overridden via .env, so this copy is never
    # actually served as-is.
    && envsubst '${RAILS_RELATIVE_URL_ROOT}' \
        < /etc/apache2/conf-available/redmine-proxy.conf.tmpl \
        > /etc/apache2/conf-available/redmine-proxy.conf \
    && a2enconf redmine-proxy \
    && chmod 0755 /usr/local/bin/redmine-entrypoint.sh /usr/local/bin/redmine-healthcheck.sh \
    && chown -R redmine:redmine ${REDMINE_HOME}/config ${REDMINE_HOME}/plugins \
    && chown -R redmine:redmine ${REDMINE_HOME}/public ${REDMINE_HOME}/themes \
    # Passenger の user switching は config.ru の所有者でアプリを起動しようと
    # します。root 所有のままだと PassengerDefaultUser (nobody) へフォールバック
    # し、files/ や log/ に書けなくなります（conf 側の PassengerUser と併用）。
    && chown redmine:redmine ${REDMINE_HOME}/config.ru

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/redmine-entrypoint.sh"]
