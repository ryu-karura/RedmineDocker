# Docker0: PostgreSQL 18 + PostGIS master
#
# Base image: postgis/postgis:18-master
# OS image: Debian trixie (via the upstream postgis/postgis image)

FROM docker.io/postgis/postgis:18-master

ENV POSTGRES_DB=redmine_prod
ENV POSTGRES_INITDB_ARGS="--auth-host=scram-sha-256 --auth-local=peer --encoding=UTF8 --locale=C.UTF-8"

# Keep the postgres UID aligned with the host-side bind-mount ownership
# convention used by this repository.
USER root
RUN usermod -u 26 postgres \
    && chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql

# Apply Redmine-specific PostgreSQL settings and initialize the shared Redmine
# database user during the upstream first-run init sequence.
COPY entrypoint.sh /docker-entrypoint-initdb.d/20-configure-redmine-postgres.sh
COPY init-postgis.sh /docker-entrypoint-initdb.d/30-init-redmine-postgis.sh
RUN chmod 0755 \
        /docker-entrypoint-initdb.d/20-configure-redmine-postgres.sh \
        /docker-entrypoint-initdb.d/30-init-redmine-postgis.sh
