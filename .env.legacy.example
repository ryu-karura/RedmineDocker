# .env.legacy.example
#
# 移行元 (Redmine 5.1.1 + MySQL 8.0 CE) を再現し、PostgreSQL 18 へコンバートする
# ための、compose.legacy.yaml 専用の環境変数ファイルです。手順は docs/Upgrade.md
# 参照。通常構成（Redmine 5/6/7 + PostgreSQL 18 + PostGIS 3.6、compose.dev.yaml /
# .env.example）には一切影響しません。
#
# ★ 役割: このファイルは compose.dev.yaml 用の .env とは別物です。混在させない
#   でください — 通常スタックの変数（REDMINE_WEB_CONTAINERFILE, REDMINE_VERSION,
#   REDMINE_DB_NAME/USER 等）はここには置かず、常に .env.example 側で管理します。
#
# 使い方:
#   cp .env.legacy.example .env.legacy
#   docker compose --env-file .env.legacy -f compose.legacy.yaml up --build -d
#
# REDMINE_DB_NAME / REDMINE_DB_USER は指定しません（.env.example 側の値を使う
# ため、compose.legacy.yaml の既定値 "redmine" のままで問題なければ何もしなくて
# 構いません。.env.example 側でカスタマイズした場合は、その環境ではこのファイルに
# 加えて --env-file .env も渡してください:
#   docker compose --env-file .env --env-file .env.legacy -f compose.legacy.yaml ...）

# ── [Host] [redmine-web] 移行元 (Redmine 5.1.1 + MySQL 8.0) 再現スタック ─────
# 移行元と移行先 (compose.dev.yaml) は同時に起動する必要があるため（コンバート
# 時）、コンテナ名・ネットワーク・ボリューム・ポートを通常構成と別にしています。
REDMINE_LEGACY_NETWORK=redmine-legacy-net
REDMINE_LEGACY_DB_CONTAINER=redmine-legacy-db
REDMINE_LEGACY_WEB_CONTAINER=redmine-legacy-web
REDMINE_LEGACY_DB_VOLUME=redmine_legacy_mysqldata
REDMINE_LEGACY_FILES_VOLUME=redmine_legacy_web_files
REDMINE_LEGACY_WEB_HOST_PORT=8081
REDMINE_LEGACY_DB_BASE_IMAGE=docker.io/library/mysql:8.0
REDMINE_LEGACY_DB_IMAGE=localhost/redmine-db-mysql:8.0
REDMINE_LEGACY_WEB_CONTAINERFILE=Containerfile.v5-mysql
REDMINE_LEGACY_WEB_BASE_IMAGE=docker.io/library/redmine:5.1.1
REDMINE_LEGACY_WEB_IMAGE=localhost/redmine-web:5.1.1-mysql

# pgloader のイメージ（MySQL → PostgreSQL のデータ転送に使用）
PGLOADER_IMAGE=docker.io/dimitri/pgloader:v3.6.7

# 移行元に、既にアンインストール済みのプラグインが残した孤立テーブル
# （plugins/ 配下にコードは無いがマイグレーションだけ残っているテーブル）が
# ある場合、カンマ区切りで指定すると scripts/migrate-mysql-to-postgres.sh の
# schema/data/verify 全ステップで除外されます（docs/Upgrade.md 9.4 参照）。
# コマンドラインの --exclude-tables でも同じ指定ができます（そちらが優先）。
# MIGRATE_EXCLUDE_TABLES=client_applications,oauth_nonces,oauth_tokens

# ── [Host] [redmine-web] 移行元のバージョン・プラグイン構成のまま DB だけ
#    PostgreSQL へ切り替える（恒久運用、Redmine 6/7 へのアップグレードは保留） ──
# scripts/migrate-mysql-to-postgres.sh でデータを移した後、compose.legacy.yaml に
# compose.legacy-on-postgres.yaml を重ねて起動すると、redmine-legacy-web が
# compose.dev.yaml の redmine-db (PostgreSQL 18 + PostGIS 3.6) へ postgresql
# アダプタで恒久的に接続します（redmine_gtt を積まない構成のため postgis 固有
# 機能は不要 — postgresql アダプタで機能的に十分です）。詳細は
# docs/Upgrade.md §4.1。
#
#   docker compose --env-file .env --env-file .env.legacy \
#       -f compose.legacy.yaml -f compose.legacy-on-postgres.yaml \
#       up --build -d --no-deps redmine-legacy-web
#   docker compose --env-file .env.legacy -f compose.legacy.yaml stop redmine-legacy-db
#
# --no-deps が必要な理由: compose.legacy.yaml の redmine-legacy-web は
# redmine-legacy-db の healthy を条件に依存しますが、この運用ではその MySQL は
# 停止済みのため、依存関係の自動起動をスキップします。
