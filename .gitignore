# RedmineDocker .gitignore

# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
# Password and secret_key_base files generated by scripts/generate-secrets.sh
# and consumed as compose file secrets.
/secrets/
secrets/*.txt

# ── Corporate proxy CA certificates (site-specific, do not commit) ───────────
# Drop the CA of a TLS-intercepting proxy here on each host; the Containerfiles
# copy the directory into the image. See containers/redmine-web/ca-certificates/README.md
containers/redmine-web/ca-certificates/*.crt
containers/redmine-web/ca-certificates/*.pem

# ── Environment files (non-secret overrides) ─────────────────────────────────
# Optional. .env is for compose.dev.yaml (use .env.example as a reference);
# .env.legacy is for compose.legacy.yaml (use .env.legacy.example as a reference).
.env
.env.legacy

# ── Backup files ──────────────────────────────────────────────────────────────
# Backup archives are stored under /opt/redmine/backup/ on the host, not in the repo
*.dump
*.tar.gz

# ── Container layer cache ─────────────────────────────────────────────────────
.containerignore

# ── Editor and OS files ───────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ── Temporary files ───────────────────────────────────────────────────────────
/tmp/
