# RedmineDocker .gitignore

# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
# Password and secret_key_base files generated by scripts/generate-secrets.sh
# and consumed by compose.dev.yaml / Podman secrets.
/secrets/
secrets/*.txt

# ── Environment file (non-secret SMTP/TZ overrides) ──────────────────────────
# Optional. Use .env.example as a reference.
.env

# ── Backup files ──────────────────────────────────────────────────────────────
# Backup archives are stored under /opt/redmine/backup/ on the host, not in the repo
*.dump
*.tar.gz

# ── Container layer cache ─────────────────────────────────────────────────────
.containerignore

# ── Editor and OS files ───────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ── Temporary files ───────────────────────────────────────────────────────────
/tmp/
