# .env.example
#
# Template for the RedmineDocker environment variables file.
# DO NOT use this file directly in production.
#
# GENERATE the actual .env file using:
#   sudo bash /opt/redmine/containers/scripts/generate-env.sh
#
# The script generates cryptographically random 16-character alphanumeric
# passwords as required by the project security policy.
#
# The actual .env file:
#   - Is located at /opt/redmine/containers/.env
#   - Has permissions 600 (owner root only)
#   - Is excluded from git via .gitignore
#   - Must be backed up securely outside the repository

# ── PostgreSQL Superuser Password ─────────────────────────────────────────────
# 16-character alphanumeric, generated by generate-env.sh
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# ── Shared Redmine Database User Password ─────────────────────────────────────
# 16-character alphanumeric, shared across redmine_prod / redmine_test / redmine_next
REDMINE_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# ── Redmine Secret Key Base ───────────────────────────────────────────────────
# 128-character hex string, generated by generate-env.sh
# Each environment MUST have a unique token
REDMINE_SECRET_TOKEN=REPLACE_WITH_GENERATED_VALUE
REDMINE2_SECRET_TOKEN=REPLACE_WITH_GENERATED_VALUE
REDMINE3_SECRET_TOKEN=REPLACE_WITH_GENERATED_VALUE

# ── SMTP Configuration ────────────────────────────────────────────────────────
# Configure for outbound email notifications from Redmine
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=redmine@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
