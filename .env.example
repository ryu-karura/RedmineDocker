# .env.example
#
# Template for the OPTIONAL, NON-SECRET environment file used by the redmine stack.
#
# Passwords are NOT stored here — they live in secret files generated by
# scripts/generate-secrets.sh (secrets/db_password.txt, secrets/secret_key_base.txt)
# and are injected via Docker/Podman secrets.
#
# Runtime identifiers (container names, DB user/name, sub-URI, ports, etc.) are
# centralized here so compose and operational scripts can share the same values.
#
# Development (Docker Compose): compose.dev.yaml reads this file automatically.
# Production (Podman Quadlet): copy this to /opt/redmine/containers/.env;
# quadlets/redmine-web.container loads it via EnvironmentFile (optional).

# ── Stack Identity / Runtime Defaults ─────────────────────────────────────────
STACK_NAME=redmine
REDMINE_NETWORK=redmine-net

REDMINE_DB_CONTAINER=redmine-db
REDMINE_WEB_CONTAINER=redmine-web

# Canonical component versions.
REDMINE_VERSION=6.1.3
REDMINE_DB_PG_MAJOR=18
REDMINE_DB_POSTGIS_VERSION=3.6

# Built image tags include the same versions.
REDMINE_DB_IMAGE=localhost/redmine-db:${REDMINE_DB_PG_MAJOR}-${REDMINE_DB_POSTGIS_VERSION}
REDMINE_WEB_IMAGE=localhost/redmine-web:${REDMINE_VERSION}

# Base images for Docker build args (used by Containerfile FROM).
REDMINE_DB_BASE_IMAGE=docker.io/postgis/postgis:${REDMINE_DB_PG_MAJOR}-${REDMINE_DB_POSTGIS_VERSION}
REDMINE_WEB_BASE_IMAGE=docker.io/library/redmine:${REDMINE_VERSION}

REDMINE_DB_NAME=redmine
REDMINE_DB_USER=redmine
REDMINE_DATA_DIR=/opt/redmine/data/redmine
REDMINE_FILES_ARCHIVE_PREFIX=redmine

REDMINE_SUBURI=/redmine

# Compose dev publish: 127.0.0.1:8080 -> container:80
REDMINE_WEB_BIND_HOST=127.0.0.1
REDMINE_WEB_HOST_PORT=8080
REDMINE_WEB_CONTAINER_PORT=80

# Internal ports used by healthchecks and startup wait loops.
REDMINE_DB_PORT=5432
REDMINE_PUMA_PORT=3000

# Codespaces override publish: 0.0.0.0:80 -> container:80
CODESPACES_WEB_BIND_HOST=0.0.0.0
CODESPACES_WEB_HOST_PORT=80

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Tokyo

# ── SMTP Configuration (outbound email notifications) ────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=redmine@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
