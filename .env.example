# .env.example
#
# redmine スタック（Redmine 5 / 6 / 7 系 + PostgreSQL 18 + PostGIS 3.6）用の、
# 任意の非シークレット環境変数ファイルのテンプレートです。
#
# ★ 役割: このファイルは compose.dev.yaml 専用です。移行元 (Redmine 5.1.1 +
#   MySQL 8.0 CE) を再現・コンバートする compose.legacy.yaml は、別ファイルの
#   .env.legacy.example を使います（cp .env.legacy.example .env.legacy）。
#   2 つのスタックの変数を同じ .env に混在させないでください — 手順は
#   docs/Upgrade.md 参照。
#
# パスワードはここには保存しません。
# scripts/generate-secrets.sh が生成するシークレットファイル
# （secrets/db_password.txt, secrets/secret_key_base.txt）に保存し、
# Docker/Podman secrets 経由で注入します。
#
# 実行時識別子（コンテナ名、DB ユーザー/DB 名、SUBURI、ポート等）は
# ここに集約し、compose と運用スクリプトで同じ値を共有します。
#
# 開発（Docker Compose）: compose.dev.yaml がこのファイルを自動読み込みします。
# 本番（Docker Compose + systemd）: /opt/redmine/containers/.env として配置します。
# systemd/redmine.service は WorkingDirectory=/opt/redmine/containers で
# `docker compose -f compose.dev.yaml -f compose.prod.yaml` を実行するため、
# 本番でも**このファイルがそのまま効きます**（コンテナ名・ポート・データ配置・
# DB 名まで含めて、開発と同じ 1 ファイルで設定できます）。
#
# 利用先ラベル:
#   [Host]        ホスト/オーケストレーション設定（Compose のみで使用）
#   [redmine-web] redmine-web コンテナに環境変数として渡される
#   [redmine-db]  redmine-db コンテナ（初期化/ヘルスチェック等）で参照される
#   [Scripts]     scripts/backup.sh, scripts/restore.sh で参照される

# ── [Host] スタック識別子 / 実行時既定値 ─────────────────────────────────────
# COMPOSE_PROJECT_NAME は Compose 仕様上の特別な変数名で、compose.dev.yaml の name: より
# 優先され、Compose/podman-compose が .env から直接読み込みます（compose.dev.yaml 側での
# 変数展開を経由しないため、podman-compose の name: フィールド展開バグを回避できます）。
# ネットワーク名・コンテナ名・ボリューム名とあわせて別々の値にすると、同じチェックアウトから
# 2 つ目の開発スタックを並行起動できます（例: docker compose --env-file .env.stack2 -f
# compose.dev.yaml up --build -d、REDMINE_WEB_HOST_PORT も別ポートにすること）。
COMPOSE_PROJECT_NAME=redmine
REDMINE_NETWORK=redmine-net

REDMINE_DB_CONTAINER=redmine-db
REDMINE_WEB_CONTAINER=redmine-web

REDMINE_DB_VOLUME=redmine_pgdata
REDMINE_FILES_VOLUME=redmine_web_files

# ── [redmine-web] アプリサーバー ─────────────────────────────────────────────
# redmine-web コンテナ内で Redmine を動かす方式を選びます。
#   passenger (既定) コンテナ内 Apache の mod_passenger が Redmine を直接
#                    起動します。Puma と :${REDMINE_PUMA_PORT} は使いません。
#                    静的資産は Apache が public/ から直接配信します。
#   puma             コンテナ内 Apache が ${REDMINE_SUBURI} を Puma
#                    (127.0.0.1:${REDMINE_PUMA_PORT}) へ ProxyPass します。
#                    静的資産は Rails (RAILS_SERVE_STATIC_FILES) が配信します。
# イメージには両方式が同梱されているため、切り替えはこの値の変更とコンテナ
# 再起動のみで反映されます（イメージ再ビルドは不要）。本番も同じ compose 定義を
# 読むため、この 1 行を変えて `sudo systemctl reload redmine` するだけです。
#
# ★ 既定値は 7 系（Containerfile.v7 / 既定のシリーズ）のものです。
#   mod_passenger は 3 系列とも Debian trixie の 6.0.26 です。7 系のベースは
#   Ruby 4.0 ですが、この版のままで動作することを実機で確認しています
#   （docs/Design.md「9. Redmine シリーズの切り替え」）。
#   5 系 / 6 系のイメージ既定は puma です（passenger も使えます）。この値は
#   compose から常にコンテナへ渡るため、5 系 / 6 系へ切り替えて puma で
#   動かしたいときはここも puma にしてください。
#   本番へ出す前に
#   `bash scripts/test-stack.sh --series 7 --web-server passenger`
#   （puma に戻すなら `--web-server puma`）で実際に動くか確認してください。
REDMINE_WEB_SERVER=passenger

# ── [redmine-web] Ruby YJIT ──────────────────────────────────────────────────
# redmine:7.0.1 の Ruby 4.0（5 系は Ruby 3.2、6 系は Ruby 3.4）は YJIT を
# ビルドに含みますが既定では無効で、Redmine 自体も
# config.yjit を設定していません。RUBY_YJIT_ENABLE は Ruby 本体が直接読む環境変数で、
# Puma (bundle exec rails server) にそのまま渡って有効化されます。無効化したい場合は
# 0 にしてください（コンテナの再起動のみで反映、イメージ再ビルドは不要です）。
RUBY_YJIT_ENABLE=0

# ── [Host] プロキシ環境 ──────────────────────────────────────────────────────
# 社内プロキシ経由でイメージを**ビルド**する場合に設定します（未設定なら無効）。
# compose の build args 経由で、ビルド中の apt-get / git clone / bundle install に
# 渡ります（HTTP_PROXY / HTTPS_PROXY / NO_PROXY は docker の predefined build args
# なので Containerfile 側の ARG 宣言は不要です）。シェルに export 済みならその値が
# そのまま使われるため、このファイルでの設定は任意です。
#
# ★ ベースイメージの pull（Containerfile の FROM）は docker デーモンが行うため、
#   ここではなく**デーモン側にも**プロキシ設定が必要です。
# ★ TLS を再終端する（MITM する）プロキシ配下では、CA 証明書を
#   containers/redmine-web/ca-certificates/ へ置く必要があります。
#   どちらも docs/Setup.md「プロキシ環境で使う場合」を参照してください。
# ★ NO_PROXY には最低でも localhost / 127.0.0.1 / コンテナ名を入れてください。
#HTTP_PROXY=http://proxy.example.co.jp:8080
#HTTPS_PROXY=http://proxy.example.co.jp:8080
#NO_PROXY=localhost,127.0.0.1,::1,redmine-db,redmine-web

# ── [Host] Redmine シリーズの切り替え ────────────────────────────────────────
# redmine-web は Redmine のメジャーバージョン系列ごとに Containerfile を分けて
# います。プラグイン/テーマの対応バージョンが系列ごとに違うためです
# （対応状況の根拠は docs/Design.md「Redmine シリーズの切り替え」参照）。
# 3 系列とも DB は PostgreSQL 18 + PostGIS 3.6（postgis アダプタ）です。
#
#   Containerfile.v5 … Redmine 5.1.12 + 12 plugins（login_audit2 と
#                       solid_queue は 5.1 で導入不可のため非同梱）
#   Containerfile.v6 … Redmine 6.1.4  + 14 plugins
#   Containerfile.v7 … Redmine 7.0.1  + 14 plugins（既定。banner だけタグでは
#                       なく master 固定 — 7.0 対応が未タグのため）
#
# 切り替えは REDMINE_VERSION と REDMINE_WEB_CONTAINERFILE の 2 つを必ずセットで
# 変更してください（REDMINE_WEB_BASE_IMAGE / REDMINE_WEB_IMAGE は
# REDMINE_VERSION から生成されます）。一度に起動できるのは 1 系列だけです
# （コンテナ名・ポート・ボリュームは系列間で共通のため）。
# データベースの中身は系列間で互換ではありません。5→6→7 と上げる場合は
# 起動時のマイグレーションが片道で走ります（docs/Manual.md 参照）。
#
#   Redmine 5 系: REDMINE_VERSION=5.1.12 / REDMINE_WEB_CONTAINERFILE=Containerfile.v5
#   Redmine 6 系: REDMINE_VERSION=6.1.4  / REDMINE_WEB_CONTAINERFILE=Containerfile.v6
#   Redmine 7 系: REDMINE_VERSION=7.0.1  / REDMINE_WEB_CONTAINERFILE=Containerfile.v7（既定）
REDMINE_WEB_CONTAINERFILE=Containerfile.v7

# ── [Host] コンポーネント基準バージョン ─────────────────────────────────────
# イメージタグと FROM ベースイメージの生成に使われます。
# 例：docker.io/library/redmine:7.0.1
# 例：docker.io/postgis/postgis:18-3.6
REDMINE_VERSION=7.0.1
REDMINE_DB_PG_MAJOR=18
REDMINE_DB_POSTGIS_VERSION=3.6

# ── [Host] ビルド済みイメージタグ ────────────────────────────────────────────
# Compose の image 名、Podman build -t のタグで使います。
REDMINE_DB_IMAGE=localhost/redmine-db:${REDMINE_DB_PG_MAJOR}-${REDMINE_DB_POSTGIS_VERSION}
REDMINE_WEB_IMAGE=localhost/redmine-web:${REDMINE_VERSION}

# ── [Host] Docker build-arg 用ベースイメージ ─────────────────────────────────
# Containerfile の FROM へ build-arg 経由で渡します。
REDMINE_DB_BASE_IMAGE=docker.io/postgis/postgis:${REDMINE_DB_PG_MAJOR}-${REDMINE_DB_POSTGIS_VERSION}
REDMINE_WEB_BASE_IMAGE=docker.io/library/redmine:${REDMINE_VERSION}

# ── [redmine-db] [redmine-web] [Scripts] DB/データ関連 ────────────────────────
# REDMINE_DB_NAME / REDMINE_DB_USER:
#   redmine-db 初期化、redmine-web 接続、backup/restore の接続先に共通利用。
#   移行元からコンバートする場合、scripts/migrate-mysql-to-postgres.sh が
#   このファイルと .env.legacy の両方を読むため、値はここだけで管理されます
#   （.env.legacy 側には重複定義しません）。
# REDMINE_DATA_ROOT:
#   本番 (compose.prod.yaml) の bind mount 元となるデータルートです。配下に
#   postgres/${REDMINE_DB_PG_MAJOR}（DB）、redmine/files（添付）、redmine/log
#   （production.log）を作成します。開発 (compose.dev.yaml 単体) は名前付き
#   ボリュームを使うため参照されません。
# REDMINE_DATA_DIR:
#   主に restore.sh が添付ファイル復元先として使用（= ${REDMINE_DATA_ROOT}/redmine）。
# REDMINE_FILES_ARCHIVE_PREFIX:
#   backup.sh の添付ファイルアーカイブ名接頭辞として使用。
REDMINE_DB_NAME=redmine
REDMINE_DB_USER=redmine
REDMINE_DATA_ROOT=/opt/redmine/data
REDMINE_DATA_DIR=${REDMINE_DATA_ROOT}/redmine
REDMINE_FILES_ARCHIVE_PREFIX=redmine

# ── [redmine-web] [Host] サブ URI ────────────────────────────────────────────
# redmine-web の RAILS_RELATIVE_URL_ROOT と Compose healthcheck URL に使います。
REDMINE_SUBURI=/redmine

# ── [Host] compose 公開ポート ────────────────────────────────────────────────
# 127.0.0.1:${REDMINE_WEB_HOST_PORT} -> redmine-web:${REDMINE_WEB_CONTAINER_PORT}
# 下の 8080 は開発 (compose.dev.yaml 単体) 用の既定値です。
REDMINE_WEB_BIND_HOST=127.0.0.1
REDMINE_WEB_HOST_PORT=8080
REDMINE_WEB_CONTAINER_PORT=80

# 本番 (compose.prod.yaml) の公開先は別変数です。既定は 127.0.0.1:80 で、
# ホスト Apache (host-apache/redmine-proxy.conf) の ProxyPass 先と一致します。
# 開発値 8080 がそのまま本番に効いてしまわないよう、変数を分けてあります。
# 変更する場合は host-apache/redmine-proxy.conf の転送先も合わせてください。
#REDMINE_PROD_BIND_HOST=127.0.0.1
#REDMINE_PROD_HOST_PORT=80

# ── [redmine-web] DB アダプタ / マイグレーション専用モード ───────────────────
# どちらもこのファイルでは設定しません（書いてもコンテナへは渡りません）。
#   REDMINE_DB_ADAPTER   compose.dev.yaml で postgis に固定しています。
#   REDMINE_MIGRATE_ONLY マイグレーションだけ実行して Web サーバーを起動せずに終了します。
#                        restart: always と組み合わせると再起動を繰り返すため、
#                        単発起動で指定します:
#                          docker compose -f compose.dev.yaml run --rm -e REDMINE_MIGRATE_ONLY=1 redmine-web

# ── [redmine-db] [redmine-web] 内部ポート ─────────────────────────────────────
# REDMINE_DB_PORT: DB 接続待機 / DB healthcheck
# REDMINE_PUMA_PORT: redmine-web 内 Apache→Puma 転送 / web healthcheck
#   （REDMINE_WEB_SERVER=passenger のときは未使用）
REDMINE_DB_PORT=5432
REDMINE_PUMA_PORT=3000

# ── [Host] Codespaces 公開ポート（override） ─────────────────────────────────
# 0.0.0.0:${CODESPACES_WEB_HOST_PORT} -> redmine-web:${REDMINE_WEB_CONTAINER_PORT}
CODESPACES_WEB_BIND_HOST=0.0.0.0
CODESPACES_WEB_HOST_PORT=80

# ── [redmine-web] [Host] タイムゾーン ─────────────────────────────────────────
# 主に redmine-web コンテナへ渡されます。
TZ=Asia/Tokyo

# ── [redmine-web] SMTP 設定（通知メール送信） ────────────────────────────────
# compose.dev.yaml 経由で redmine-web に渡されます（開発・本番共通）。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=redmine@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
