# .env.example
#
# Template for the OPTIONAL, NON-SECRET environment file used by the hwins stack.
#
# Passwords are NOT stored here anymore — they live in secret files generated by
# scripts/generate-secrets.sh (secrets/db_password.txt, secrets/secret_key_base.txt)
# and are injected via Docker/Podman secrets. This file only carries non-secret
# overrides such as SMTP and timezone.
#
# Development (Docker Compose): the values below are already set as defaults in
#   compose.dev.yaml, so a .env file is usually not needed.
# Production (Podman Quadlet): copy this to /opt/hwins/containers/.env and edit;
#   quadlets/hwins-redmine.container loads it via EnvironmentFile (optional).

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Tokyo

# ── SMTP Configuration (outbound email notifications) ────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=redmine@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
