# .env.example
#
# Template for the OPTIONAL, NON-SECRET environment file used by the redmine
# stack. This is the single place to override container/DB naming, the
# sub-URI, the dev host port, data paths, timezone, and SMTP — instead of
# editing those values in several files. The full reference — what each
# value does, which of dev/prod actually reads it, and why some values
# CANNOT be centralised here — is docs/Design.md, "設定項目 (Configuration)".
#
# Passwords are NOT stored here — they live in secret files generated by
# scripts/generate-secrets.sh (secrets/db_password.txt, secrets/secret_key_base.txt)
# and are injected via Docker/Podman secrets.
#
# How this file is consumed (see docs/Design.md for the full picture):
#   Development (Docker Compose): copy to ./.env — `docker compose` loads it
#     automatically and every ${VAR:-default} in compose.dev.yaml resolves
#     from it. Without a ./.env, the defaults below (already baked into
#     compose.dev.yaml) apply, so copying is optional unless you want to
#     change something.
#   Production (Podman Quadlet): copy to /opt/redmine/containers/.env.
#     - quadlets/redmine-web.container reads it via EnvironmentFile=, but only
#       for the container's own process environment: SMTP_* and TZ below.
#       Podman Quadlet *.container units have no envsubst/variable-
#       substitution pass over their own directives, so DB_CONTAINER_NAME,
#       WEB_CONTAINER_NAME, NETWORK_NAME, DB_NAME, DB_USER,
#       RAILS_RELATIVE_URL_ROOT and DATA_ROOT below are NOT read by the
#       quadlets themselves — those are hardcoded in quadlets/*.container and
#       must be edited there directly if you ever need to change them.
#     - scripts/backup.sh and scripts/restore.sh DO read this file directly
#       (they're plain bash, not Quadlet units): DB_NAME, DB_USER,
#       DB_CONTAINER_NAME, WEB_CONTAINER_NAME and DATA_ROOT below control them.

# ── Container / network naming ────────────────────────────────────────────────
# Dev (compose.dev.yaml): renames container_name / the network's registered
#   name. Purely cosmetic — cross-container connectivity uses the fixed
#   Compose service keys (redmine-db / redmine-web), not these values.
# Prod: NOT read by quadlets/*.container (see above); also, the systemd unit
#   names (redmine-db.service / redmine-web.service) come from the Quadlet
#   *filenames*, not from ContainerName=, so renaming here never renames the
#   systemd units backup.sh/restore.sh and docs/Manual.md's systemctl/
#   journalctl commands refer to.
DB_CONTAINER_NAME=redmine-db
WEB_CONTAINER_NAME=redmine-web
NETWORK_NAME=redmine-net

# ── Database name / user ──────────────────────────────────────────────────────
# Dev: sets POSTGRES_DB/POSTGRES_USER (redmine-db) and REDMINE_DB_NAME/
#   REDMINE_DB_USER (redmine-web) from one value each.
# Prod: NOT read by quadlets/*.container; scripts/backup.sh and
#   scripts/restore.sh DO read these two.
DB_NAME=redmine
DB_USER=redmine

# ── Sub-URI ────────────────────────────────────────────────────────────────────
# Dev: sets RAILS_RELATIVE_URL_ROOT and is substituted into the Apache proxy
#   vhost that entrypoint.sh renders from httpd-redmine.conf.tmpl.
# Prod: NOT read by quadlets/*.container. If you change this in production,
#   you must also hand-edit, to match: quadlets/redmine-web.container's
#   Environment=RAILS_RELATIVE_URL_ROOT= and HealthCmd= lines, and
#   host-apache/redmine-proxy.conf's ProxyPass/ProxyPassReverse lines.
RAILS_RELATIVE_URL_ROOT=/redmine

# ── Dev-only host port ────────────────────────────────────────────────────────
# Production keeps host port 80 fixed by design (rootless Podman can't bind
# <1024 without host prep; see CLAUDE.md, "one deliberate divergence") — this
# variable has no production equivalent.
WEB_HOST_PORT=8080

# ── Data root ──────────────────────────────────────────────────────────────────
# Prod only: read by scripts/backup.sh and scripts/restore.sh to locate
# secrets/, backup/ and data/ under one root. NOT read by quadlets/*.container
# — the actual bind-mount paths in quadlets/redmine-db.container and
# quadlets/redmine-web.container's Volume= lines are hardcoded and are NOT
# relocated by changing this value; edit those files too if you ever move
# the data root off /opt/redmine.
DATA_ROOT=/opt/redmine

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Tokyo

# ── SMTP Configuration (outbound email notifications) ────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=redmine@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
